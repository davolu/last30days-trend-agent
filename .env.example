# Copy to .env (or export in your shell). Never commit the real file.

# Used only by scripts/synthesize_brief.py to write the brief.
ANTHROPIC_API_KEY=

# Optional: override the model (default claude-haiku-5-5).
# BRIEF_MODEL=claude-haiku-5-5

# The last30days engine itself needs no keys for the sources in this repo.
# Its own config lives in ~/.config/last30days/.env (chmod 600).
